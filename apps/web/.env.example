SESSION_SECRET=replace-with-long-random-string-min-32-chars
BEVEL_DEFAULT_USERNAME=admin
BEVEL_DEFAULT_NAME=مدير Bevel
BEVEL_DEFAULT_PASSWORD=Bevel@2026
COOKIE_SECURE=false
BEVEL_SYNC_ADMIN_PASSWORD=true

# Persistent data (production VPS — lives outside the app, set by deploy script)
# BEVEL_DATA_DIR=/var/lib/bevel/data
# BEVEL_PROJECTS_DIR=/var/lib/bevel/projects

# WhatsApp OTP (mock mode enabled by default for development)
WHATSAPP_MOCK=true
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=bevel_otp
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
